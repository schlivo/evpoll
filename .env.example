# Server configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Database path (relative to backend directory)
DB_PATH=./data/survey.db

# CORS origin (for development)
CORS_ORIGIN=http://localhost:5173

# Admin configuration
ADMIN_PASSWORD=irve2024

# Instance (copro-specific config: name, staircases, parking lots, campaign,
# privacy notice parameters, admin parking plan). See instances/demo/.
# Keep real instances outside this public repo.
INSTANCE_DIR=../instances/demo
# Optional physical description (copro, entrances, staircases, parking lots)
# in a separate JSON file; instance.json values win over it
# PARKING_CONFIG=/path/to/parking.json

# Optional overrides of the instance values (env wins when set)
# COPRO_NAME=Ma Copropriété
# BUILDINGS=A,B,C,D        # BUILDINGS= (empty) hides the building question
# TOTAL_LOTS=75
# PARKING_SPOTS=94         # spots numbered 1..N; unset and no instance: free text
# CAMPAIGN_DEADLINE=2026-11-15
# CAMPAIGN_SIGNATURE=Le conseil syndical
# DATA_CONTROLLER=Prénom Nom, copropriétaire, à l'initiative du conseil syndical
# RETENTION_DAYS=730       # responses are deleted this many days after submission
# AUDIT_RETENTION_DAYS=365 # security log (IP addresses)

# Contact emails
CONTACT_EMAIL=conseil-syndical@exemple.fr
SYNDIC_EMAIL=syndic@exemple.fr
